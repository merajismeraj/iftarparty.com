<%- include('partials/head') %>
<section class="search-band">
  <div class="wrap">
    <% const crit = [q.location, q.date && fmt.shortDate(q.date), q.guests && `${q.guests} guests`, q.menu,
         (q.budget || q.max_price) && `${money.format(money.toMinor(q.budget || q.max_price))}${q.budget_type === 'total' ? ' total' : '/guest'}`].filter(Boolean); %>
    <div class="search-panel" data-search-panel <%= crit.length ? 'data-has-criteria' : '' %>>
      <button type="button" class="search-summary" data-search-expand aria-controls="search-form">
        <span><strong><%= crit.length ? crit.slice(0, 2).join(' · ') : 'All venues' %></strong><% if (crit.length > 2) { %><span class="small muted"><%= crit.slice(2).join(' · ') %></span><% } else if (!crit.length) { %><span class="small muted">Location, date, guests, menu, budget</span><% } %></span>
        <span class="edit">Edit search</span>
      </button>
      <%- include('partials/search-form', { q, compact: true }) %>
    </div>
  </div>
</section>
<section class="wrap section">
  <%
    const keep = new URLSearchParams(Object.entries(q).filter(([k, v]) => v && k !== 'page' && typeof v === 'string'));
    const withParam = (k, v) => { const p = new URLSearchParams(keep); if (v) p.set(k, v); else p.delete(k); return `/search?${p}`; };
    const venueQs = new URLSearchParams(Object.entries({ date: q.date, guests: q.guests, budget: q.budget || q.max_price, budget_type: q.budget ? q.budget_type : undefined })
      .filter(([, v]) => v && typeof v === 'string')).toString();
  %>
  <div class="results-head">
    <h1 class="h2"><%= total %> venue<%= total === 1 ? '' : 's' %><%= q.location ? ` in “${q.location}”` : '' %><%= q.date ? ` free on ${fmt.shortDate(q.date)}` : '' %></h1>
    <div class="filters">
      <span class="muted small">Diet:</span>
      <a class="chip <%= !q.diet ? 'on' : '' %>" href="<%= withParam('diet', '') %>">Any</a>
      <a class="chip <%= q.diet === 'veg' ? 'on' : '' %>" href="<%= withParam('diet', 'veg') %>">Veg</a>
      <a class="chip <%= q.diet === 'non-veg' ? 'on' : '' %>" href="<%= withParam('diet', 'non-veg') %>">Non-veg</a>
      <span class="muted small sep">Sort:</span>
      <a class="chip <%= !q.sort || q.sort === 'price' ? 'on' : '' %>" href="<%= withParam('sort', '') %>">Lowest price</a>
      <a class="chip <%= q.sort === 'rating' ? 'on' : '' %>" href="<%= withParam('sort', 'rating') %>">Top rated</a>
      <a class="chip <%= q.sort === 'capacity' ? 'on' : '' %>" href="<%= withParam('sort', 'capacity') %>">Largest</a>
      <a class="chip <%= q.sort === 'newest' ? 'on' : '' %>" href="<%= withParam('sort', 'newest') %>">Newest</a>
    </div>
  </div>
  <% if (budgetNeedsGuests) { %><div class="flash flash-info">Add the number of guests to filter by a total budget.</div><% } %>
  <% if (budget && !budgetNeedsGuests) { %><p class="small muted">Budget: <strong><%= money.format(budget.amount) %></strong> <%= budget.type === 'total' ? `total for ${q.guests} guests – food, hall & service fee (extras not included)` : 'per guest' %>.</p><% } %>
  <% if (!rows.length) { %>
    <div class="empty">
      <p class="lead">No venues match all of those filters.</p>
      <p class="muted">Try a nearby area, a different date, or raising your budget.</p>
      <a class="btn btn-ghost" href="/search">Clear filters</a>
    </div>
  <% } else { %>
    <div class="grid cards">
      <% rows.forEach(v => { %><%- include('partials/venue-card', { v, qs: venueQs, est: budget && budget.type === 'total' && Number(q.guests) > 0 ? Math.round((v.from_price * Number(q.guests) + v.hire_fee) * (100 + feePercent) / 100) : null }) %><% }) %>
    </div>
    <% if (pages > 1) { %>
      <nav class="pager">
        <% if (page > 1) { %><a class="btn btn-ghost" href="<%= withParam('page', page - 1) %>">← Previous</a><% } %>
        <span class="muted">Page <%= page %> of <%= pages %></span>
        <% if (page < pages) { %><a class="btn btn-ghost" href="<%= withParam('page', page + 1) %>">Next →</a><% } %>
      </nav>
    <% } %>
  <% } %>
</section>
<%- include('partials/foot') %>
