<%- include('partials/head') %>
<%
  const keep = new URLSearchParams(Object.entries(q).filter(([k, v]) => v && k !== 'page' && typeof v === 'string'));
  const withParam = (k, v) => { const p = new URLSearchParams(keep); if (v) p.set(k, v); else p.delete(k); p.delete('page'); return `/search?${p}`; };
  const planQs = new URLSearchParams(Object.entries({ guests: q.guests, date: q.date, budget: q.budget, budget_type: q.budget_type, location: q.location })
    .filter(([, v]) => v && typeof v === 'string')).toString();
  const venueQs = new URLSearchParams(Object.entries({ date: q.date, guests: q.guests, budget: q.budget || q.max_price, budget_type: q.budget ? q.budget_type : undefined })
    .filter(([, v]) => v && typeof v === 'string')).toString();
  const crit = [q.guests && `${q.guests} guests`, q.date && fmt.shortDate(q.date),
    budget && !budgetNeedsGuests && `${budget.type === 'total' ? '' : 'up to '}${money.format(budget.amount)}${budget.type === 'total' ? ' total' : '/guest'}`,
    q.location].filter(Boolean);
  const sorts = [['', 'Lowest price'], ['rating', 'Top rated'], ['capacity', 'Largest']];
  const sortLabel = (sorts.find(([k]) => k === (q.sort === 'price' ? '' : q.sort || '')) || sorts[0])[1];
  const refined = q.diet || q.menu || (q.sort && q.sort !== 'price');
%>
<section class="results-bar">
  <div class="wrap results-bar-in">
    <p class="crit"><strong><%= crit.length ? crit.join(' · ') : 'All venues' %></strong></p>
    <a class="btn btn-small btn-ghost" href="/<%= planQs ? `?${planQs}` : '' %>"><%= crit.length ? 'Change' : 'Plan' %></a>
  </div>
</section>

<section class="wrap section">
  <div class="results-head">
    <h1 class="h2"><%= total %> venue<%= total === 1 ? '' : 's' %> available</h1>
    <details class="refine" <%= refined ? 'open' : '' %>>
      <summary><%= sortLabel %><%= q.diet === 'veg' ? ' · Veg' : '' %><%= q.menu ? ` · “${q.menu}”` : '' %></summary>
      <div class="refine-body">
        <div class="refine-row">
          <% sorts.forEach(([k, label]) => { %><a class="chip <%= sortLabel === label ? 'on' : '' %>" href="<%= withParam('sort', k) %>"><%= label %></a><% }) %>
        </div>
        <div class="refine-row">
          <a class="chip <%= q.diet === 'veg' ? 'on' : '' %>" href="<%= withParam('diet', q.diet === 'veg' ? '' : 'veg') %>">Veg only</a>
        </div>
        <form class="refine-dish" method="get" action="/search">
          <% for (const [k, v] of keep) { if (k !== 'menu') { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% } } %>
          <input name="menu" placeholder="Dish or cuisine, e.g. haleem" aria-label="Dish or cuisine" value="<%= q.menu || '' %>">
          <button class="btn btn-small">Go</button>
        </form>
      </div>
    </details>
  </div>

  <% if (budgetNeedsGuests) { %><div class="flash flash-info">Add the number of guests to filter by a total budget.</div><% } %>
  <% if (!(q.guests && q.date)) { %>
    <p class="nudge small"><a href="/<%= planQs ? `?${planQs}` : '' %>">Add your guest count and date</a> to see only venues that fit and are free.</p>
  <% } %>

  <% if (!rows.length) { %>
    <div class="empty">
      <p class="lead">No venues match.</p>
      <p class="muted">Try another date, a nearby area or a higher budget.</p>
      <a class="btn btn-ghost" href="/<%= planQs ? `?${planQs}` : '' %>">Change search</a>
    </div>
  <% } else { %>
    <div class="grid cards">
      <% rows.forEach(v => { %><%- include('partials/venue-card', { v, qs: venueQs, est: budget && budget.type === 'total' && Number(q.guests) > 0 ? Math.round((v.from_price * Number(q.guests) + v.hire_fee) * (100 + feePercent) / 100) : null }) %><% }) %>
    </div>
    <% if (pages > 1) { %>
      <nav class="pager">
        <% if (page > 1) { %><a class="btn btn-ghost" href="<%= withParam('page', page - 1) %>">← Previous</a><% } %>
        <span class="muted">Page <%= page %> of <%= pages %></span>
        <% if (page < pages) { %><a class="btn btn-ghost" href="<%= withParam('page', page + 1) %>">Next →</a><% } %>
      </nav>
    <% } %>
  <% } %>
</section>
<%- include('partials/foot') %>
