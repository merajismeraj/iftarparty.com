<%- include('partials/head') %>
<section class="wrap section">
  <p class="crumbs"><a href="/search">Venues</a> › <a href="/search?location=<%= encodeURIComponent(venue.city) %>"><%= venue.city %></a> › <%= venue.name %></p>
  <div class="venue-title">
    <div>
      <h1><%= venue.name %></h1>
      <% if (rating.count) { %><p class="rating-line"><a href="#reviews"><%- include('partials/stars', { value: rating.avg }) %> <strong><%= rating.avg %></strong> <span class="muted">(<%= rating.count %> verified review<%= rating.count === 1 ? '' : 's' %>)</span></a></p><% } %>
      <p class="muted"><strong><%= venue.restaurant_name %></strong><%= venue.cuisine ? ` · ${venue.cuisine}` : '' %> · <%= [venue.address, venue.area, venue.city].filter(Boolean).join(', ') %></p>
    </div>
    <div class="pill-row">
      <span class="pill"><%= venue.min_pax %>–<%= venue.max_pax %> guests</span>
      <span class="pill"><%= venue.hire_fee ? `Hall fee ${money.format(venue.hire_fee)}` : 'No hall fee' %></span>
    </div>
  </div>

  <div class="gallery <%= images.length === 1 ? 'single' : '' %>">
    <% images.slice(0, 5).forEach((img, i) => { %>
      <img src="<%= photoUrl(img.filename) %>" alt="<%= venue.name %> photo <%= i + 1 %>" class="<%= i === 0 ? 'main' : '' %>" <%= i ? 'loading=lazy' : '' %>>
    <% }) %>
    <% if (!images.length) { %><div class="img-fallback main">No photos yet</div><% } %>
  </div>

  <div class="venue-layout">
    <div class="venue-main">
      <% if (venue.description) { %><h2 class="h3">About the hall</h2><p class="prewrap"><%= venue.description %></p><% } %>
      <% if (venue.amenities) { %>
        <div class="pill-row">
          <% venue.amenities.split(',').map(s => s.trim()).filter(Boolean).forEach(a => { %><span class="pill pill-soft"><%= a %></span><% }) %>
        </div>
      <% } %>

      <h2 class="h3" id="menus">Menus &amp; packages</h2>
      <% if (budget) { %>
        <p class="small muted">Showing fit for your budget of <strong><%= money.format(budget.amount) %></strong> <%= budget.type === 'total' ? `total${form.guests ? ` for ${form.guests} guests` : ''}` : 'per guest' %><%= budget.type === 'total' ? ' (food + hall + service fee, before extras)' : '' %>.</p>
      <% } %>
      <% if (!menus.length) { %><p class="muted">This restaurant hasn’t published a menu yet.</p><% } %>
      <div class="menu-list">
        <% menus.forEach(m => { %>
          <article class="menu-item">
            <header>
              <h3><%= m.name %> <% if (m.kind === 'package') { %><span class="pill pill-soft">Package</span><% } %> <span class="diet diet-<%= m.diet %>" title="<%= m.diet %>"><%= m.diet === 'veg' ? 'Veg' : m.diet === 'mixed' ? 'Veg & non-veg' : 'Non-veg' %></span></h3>
              <strong class="nowrap"><%= money.format(m.price_per_person) %><span class="muted small">/guest</span></strong>
            </header>
            <% if (m.fit) { %><p><span class="budget-badge <%= m.fit.fits ? 'budget-ok' : 'budget-over' %>"><%= m.fit.fits ? 'Within budget' : `Over budget by ${money.format(m.fit.over)}` %></span><% if (budget.type === 'total') { %> <span class="small muted">est. <%= money.format(m.fit.estimate) %></span><% } %></p><% } %>
            <% if (m.description) { %><p class="muted"><%= m.description %></p><% } %>
            <% if (m.kind === 'package') { %>
              <p class="small"><strong>Choose <%= packages.summary(m.rules) %></strong> <span class="muted">· minimum <%= minDishes %> dishes</span></p>
            <% } else { %>
              <ul class="dishes"><% m.items.split(/\r?\n|,/).map(s => s.trim()).filter(Boolean).forEach(d => { %><li><%= d %></li><% }) %></ul>
            <% } %>
            <% if (m.min_pax > 1) { %><p class="small muted">Minimum <%= m.min_pax %> guests</p><% } %>
          </article>
        <% }) %>
      </div>

      <% if (addons.length) { %>
        <h2 class="h3" id="extras">Extras &amp; add-ons</h2>
        <div class="addon-list">
          <% addons.forEach(a => { %>
            <article class="addon-item">
              <div><h3><%= a.name %> <span class="pill pill-soft"><%= { food: 'Food', decor: 'Décor', service: 'Service', other: 'Extra' }[a.category] %></span></h3>
                <% if (a.description) { %><p class="muted small"><%= a.description %></p><% } %></div>
              <strong class="nowrap"><%= money.format(a.price) %><span class="muted small"><%= a.pricing === 'flat' ? ' /event' : ' /guest' %></span></strong>
            </article>
          <% }) %>
        </div>
      <% } %>

      <% if (venue.restaurant_description) { %><h2 class="h3">About <%= venue.restaurant_name %></h2><p class="prewrap muted"><%= venue.restaurant_description %></p><% } %>

      <h2 class="h3" id="reviews">Reviews</h2>
      <% if (!rating.count) { %>
        <p class="muted">No reviews yet. Reviews come only from hosts who held an Iftar here.</p>
      <% } else { %>
        <%- include('partials/rating-summary', { s: rating }) %>
        <div class="review-list"><% reviewList.forEach(r => { %><%- include('partials/review-card', { r }) %><% }) %></div>
      <% } %>

      <% if (reservations.length) { %>
        <details class="more">
          <summary>Reserved evenings (<%= reservations.length %>)</summary>
          <ul class="reserved-list">
            <% reservations.forEach(r => { %><li><span class="date-badge"><%= fmt.shortDate(r.event_date) %></span> Reserved · <strong><%= r.title %></strong></li><% }) %>
          </ul>
        </details>
      <% } %>
    </div>

    <aside class="venue-aside" id="reserve">
      <form class="card book-card" method="post" action="/venues/<%= venue.id %>/reserve"
            data-quote data-hire-fee="<%= venue.hire_fee %>" data-fee-percent="<%= feePercent %>" data-currency="<%= currency %>"
            data-min-pax="<%= venue.min_pax %>" data-max-pax="<%= venue.max_pax %>" data-venue="<%= venue.id %>"
            <% if (budget) { %>data-budget="<%= budget.amount %>" data-budget-type="<%= budget.type %>"<% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h2 class="h3">Reserve this hall</h2>
        <div class="row-2">
        <label class="field">
          <span>Date</span>
          <input type="date" name="date" required min="<%= today %>" value="<%= form.date %>" data-availability>
          <small class="availability <%= taken ? 'bad' : form.date ? 'good' : '' %>" data-availability-msg>
            <%= taken ? (taken.status === 'confirmed' ? `Reserved · ${taken.title}` : 'On hold – payment in progress') : form.date ? 'Available ✓' : '' %>
          </small>
        </label>
        <label class="field">
          <span>Guests</span>
          <input type="number" name="guests" required min="<%= venue.min_pax %>" max="<%= venue.max_pax %>" inputmode="numeric" value="<%= form.guests %>" placeholder="<%= venue.min_pax %>–<%= venue.max_pax %>">
        </label>
        </div>
        <%# Arrival time can be changed later on the party's details page. %>
        <input type="hidden" name="arrival_time" value="<%= form.arrival_time %>">
        <fieldset class="field">
          <legend>Menu</legend>
          <% menus.forEach((m, i) => { const on = String(form.menu_id) === String(m.id) || (!form.menu_id && i === 0); %>
            <label class="radio-card">
              <input type="radio" name="menu_id" value="<%= m.id %>" required data-price="<%= m.price_per_person %>" data-min="<%= m.min_pax %>" <%= on ? 'checked' : '' %>>
              <span><%= m.name %><% if (m.fit && !m.fit.fits) { %> <span class="budget-badge budget-over">over</span><% } %></span><strong><%= money.format(m.price_per_person) %></strong>
            </label>
            <% if (m.kind === 'package') { %>
              <div class="picker" data-picker-for="<%= m.id %>" data-min-total="<%= minDishes %>">
                <p class="small muted">Pick at least <%= minDishes %> dishes in total (you can change them until <%= packages.EDIT_CUTOFF_DAYS %> days before the Iftar):</p>
                <% m.rules.forEach(r => { %>
                  <div class="course-block" data-course data-choose="<%= r.choose %>">
                    <div class="course-head"><strong><%= r.label %></strong><span class="small">choose up to <%= r.choose %> · <span class="count" data-course-count>0</span>/<%= r.choose %></span></div>
                    <div class="dish-pills">
                      <% r.dishes.forEach(d => { %>
                        <label class="dish-pill"><input type="checkbox" name="dish_ids" value="<%= d.id %>" <%= pickedDishes.has(String(d.id)) ? 'checked' : '' %>> <span class="diet-dot diet-<%= d.diet %>" title="<%= d.diet %>"></span><%= d.name %></label>
                      <% }) %>
                    </div>
                  </div>
                <% }) %>
                <p class="small picker-total" data-picker-total></p>
              </div>
            <% } %>
          <% }) %>
        </fieldset>

        <% if (addons.length) { %>
          <details class="field more" <%= picked.size ? 'open' : '' %>>
            <summary>Add extras <span class="muted small">(optional)</span></summary>
            <% addons.forEach(a => { %>
              <label class="radio-card">
                <input type="checkbox" name="addon_ids" value="<%= a.id %>" data-addon-price="<%= a.price %>" data-addon-pricing="<%= a.pricing %>" <%= picked.has(String(a.id)) ? 'checked' : '' %>>
                <span><%= a.name %></span><strong class="small"><%= money.format(a.price) %><%= a.pricing === 'flat' ? '' : '/guest' %></strong>
              </label>
            <% }) %>
          </details>
        <% } %>

        <div class="quote" data-quote-box hidden>
          <div><span data-q-food-label>Food</span><span data-q-food></span></div>
          <div data-q-addons-row hidden><span>Extras</span><span data-q-addons></span></div>
          <div><span>Hall fee</span><span data-q-hire></span></div>
          <div><span>Service fee (<%= feePercent %>%)</span><span data-q-fee></span></div>
          <div class="total"><span>Total</span><span data-q-total></span></div>
        </div>
        <p class="small" data-budget-msg hidden></p>
        <p class="small bad" data-quote-error hidden></p>

        <% if (user && user.role === 'restaurant') { %>
          <p class="small muted">You’re signed in as a restaurant. Sign in with a host account to book.</p>
        <% } else if (!menus.length) { %>
          <button class="btn btn-block" disabled>Menus coming soon</button>
        <% } else { %>
          <button class="btn btn-gold btn-block" <%= taken ? 'disabled' : '' %> data-reserve-btn>Reserve &amp; continue to payment</button>
          <p class="small muted center">Your hall is held for <%= locals.holdMinutes || 30 %> minutes while you pay. <%= user ? '' : 'You’ll be asked to sign in.' %></p>
        <% } %>
      </form>
    </aside>
  </div>
</section>
<% if (menus.length && !(user && user.role !== 'host')) { %>
  <div class="mobile-cta" data-mobile-cta>
    <div class="mobile-cta-price"><span class="small muted" data-cta-label>From</span><strong data-cta-amount><%= money.format(Math.min(...menus.map(m => m.price_per_person))) %><span class="small muted">/guest</span></strong></div>
    <a class="btn btn-gold" href="#reserve" <%= taken ? 'aria-disabled="true"' : '' %>><%= taken ? 'Pick another date' : 'Reserve' %></a>
  </div>
<% } %>
<%- include('partials/foot') %>
