<!doctype html>
<html>
<body style="margin:0;padding:0;background:#f4efe6;font-family:Georgia,'Times New Roman',serif;color:#1d2433;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4efe6;padding:24px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;">
        <tr><td style="background:#14213d;padding:36px 32px;text-align:center;color:#f7e7c1;">
          <div style="font-size:40px;color:#e9b949;line-height:1;">&#9790;</div>
          <p style="margin:12px 0 4px;font:600 12px Arial,sans-serif;letter-spacing:3px;text-transform:uppercase;color:#e9b949;">You're invited</p>
          <h1 style="margin:0;font-size:28px;font-weight:700;color:#ffffff;"><%= booking.title %></h1>
        </td></tr>
        <tr><td style="padding:32px;">
          <p style="font-size:18px;margin:0 0 16px;">Assalamu Alaikum <%= guest.name.split(/\s+/)[0] %>,</p>
          <p style="font:16px/1.6 Arial,sans-serif;margin:0 0 16px;"><%= booking.host_name %> would love for you to join them to break the fast together this Ramadan.</p>
          <% if (booking.invite_message) { %>
          <p style="font:italic 16px/1.6 Georgia,serif;margin:0 0 20px;padding:12px 16px;border-left:3px solid #e9b949;background:#fbf7ef;">“<%= booking.invite_message %>”</p>
          <% } %>
          <table role="presentation" width="100%" style="font:15px/1.5 Arial,sans-serif;margin:0 0 24px;">
            <tr><td style="padding:6px 0;color:#6b7280;width:70px;vertical-align:top;">When</td><td style="padding:6px 0;"><strong><%= invite.when %></strong></td></tr>
            <tr><td style="padding:6px 0;color:#6b7280;vertical-align:top;">Where</td><td style="padding:6px 0;"><strong><%= booking.venue_name %></strong>, <%= booking.restaurant_name %><br><%= [booking.address, booking.area, booking.city].filter(Boolean).join(', ') %></td></tr>
            <tr><td style="padding:6px 0;color:#6b7280;vertical-align:top;">Menu</td><td style="padding:6px 0;"><%= booking.menu_name %></td></tr>
          </table>
          <table role="presentation" align="center" cellpadding="0" cellspacing="0"><tr><td style="border-radius:999px;background:#e9b949;">
            <a href="<%= invite.link %>" style="display:inline-block;padding:14px 32px;font:700 16px Arial,sans-serif;color:#14213d;text-decoration:none;">RSVP now</a>
          </td></tr></table>
          <p style="font:13px Arial,sans-serif;color:#6b7280;text-align:center;margin:20px 0 0;">Or open: <a href="<%= invite.link %>" style="color:#14213d;"><%= invite.link %></a></p>
        </td></tr>
        <tr><td style="padding:16px 32px;background:#fbf7ef;font:12px Arial,sans-serif;color:#9ca3af;text-align:center;">Sent on behalf of <%= booking.host_name %> via IftarParty.com</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
