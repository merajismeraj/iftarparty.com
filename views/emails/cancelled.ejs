<!doctype html>
<html>
<body style="margin:0;padding:0;background:#fbf7f1;font-family:Inter,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#111111;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fbf7f1;padding:24px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border-radius:18px;overflow:hidden;box-shadow:0 8px 24px rgba(42,27,61,0.08);">
        <tr><td style="padding:28px 32px;background:#2a1b3d;background-image:linear-gradient(135deg,#2a1b3d 0%,#4f2a52 48%,#b4532a 100%);color:#ffffff;">
          <p style="margin:0 0 22px;font-size:15px;font-weight:800;letter-spacing:-0.3px;color:#ffffff;">iftarparty<span style="color:#ffb37d;">.</span></p>
          <p style="margin:0 0 6px;font-size:13px;color:#ffc9a8;font-weight:600;">Event cancelled</p>
          <h1 style="margin:0;font-size:24px;line-height:1.2;letter-spacing:-0.5px;font-weight:800;color:#ffffff;"><%= booking.title %></h1>
        </td></tr>
        <tr><td style="padding:28px 32px 8px;">
          <p style="margin:0 0 14px;font-size:16px;line-height:1.6;">Assalamu Alaikum <%= guest.name.split(/\s+/)[0] %>, we’re sorry to let you know that this Iftar on <strong><%= fmt.longDate(booking.event_date) %></strong> at <%= venueLine %> has been cancelled.</p>
          <% if (booking.cancel_reason) { %><p style="margin:0 0 14px;padding:12px 16px;background:#fbf7f1;border-radius:10px;font-size:15px;">Reason: <%= booking.cancel_reason %></p><% } %>
          <p style="margin:0;font-size:15px;line-height:1.6;color:#6b6b6b;"><%= booking.host_name %> will be in touch if it’s rescheduled. No action is needed from you.</p>
        </td></tr>
        <tr><td style="padding:16px 32px;border-top:1px solid #eadfd2;font-size:12px;color:#6b6b6b;">Sent on behalf of <%= booking.host_name %> via IftarParty</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
