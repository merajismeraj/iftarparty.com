<!doctype html>
<html>
<body style="margin:0;padding:0;background:#f4efe6;font-family:Georgia,'Times New Roman',serif;color:#1d2433;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4efe6;padding:24px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;">
        <tr><td style="background:#14213d;padding:28px 32px;text-align:center;">
          <p style="margin:0 0 6px;font:600 12px Arial,sans-serif;letter-spacing:3px;text-transform:uppercase;color:#e9b949;">Event cancelled</p>
          <h1 style="margin:0;font-size:24px;color:#ffffff;"><%= booking.title %></h1>
        </td></tr>
        <tr><td style="padding:28px 32px;font:16px/1.6 Arial,sans-serif;">
          <p style="margin:0 0 14px;">Assalamu Alaikum <%= guest.name.split(/\s+/)[0] %>,</p>
          <p style="margin:0 0 14px;">We’re sorry to let you know that <strong><%= booking.title %></strong> on <strong><%= fmt.longDate(booking.event_date) %></strong> at <%= venueLine %> has been <strong>cancelled</strong>.</p>
          <% if (booking.cancel_reason) { %><p style="margin:0 0 14px;padding:10px 14px;background:#fbf7ef;border-left:3px solid #e9b949;">Reason: <%= booking.cancel_reason %></p><% } %>
          <p style="margin:0;"><%= booking.host_name %> will be in touch if the Iftar is rescheduled. No action is needed from you.</p>
        </td></tr>
        <tr><td style="padding:14px 32px;background:#fbf7ef;font:12px Arial,sans-serif;color:#9ca3af;text-align:center;">Sent on behalf of <%= booking.host_name %> via IftarParty.com</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
