<%- include('../partials/head') %>
<% const editing = Boolean(venue.id); const fee = locals.rawFee ? venue.hire_fee : money.toMajor(venue.hire_fee);
   const extraFee = locals.rawFee ? venue.extra_time_fee : money.toMajor(venue.extra_time_fee || 0); %>
<section class="wrap narrow page-pad">
  <p class="crumbs"><a href="/restaurant">Dashboard</a> › <%= editing ? 'Edit venue' : 'New venue' %></p>
  <div class="card form-card">
    <h1 class="h2"><%= editing ? `Edit ${venue.name}` : 'Add a party venue' %></h1>
    <%- include('../partials/errors') %>
    <form method="post" enctype="multipart/form-data" action="<%= editing ? `/restaurant/venues/${venue.id}` : '/restaurant/venues' %>?_csrf=<%= csrfToken %>">
      <label class="field"><span>Venue name</span><input name="name" required maxlength="120" value="<%= venue.name || '' %>" placeholder="Noor Rooftop Lounge"></label>
      <div class="row-3">
        <label class="field"><span>Min guests</span><input type="number" name="min_pax" min="1" required value="<%= venue.min_pax %>"></label>
        <label class="field"><span>Max guests (pax)</span><input type="number" name="max_pax" min="1" required value="<%= venue.max_pax %>"></label>
        <label class="field"><span>Venue hire fee (<%= currency %>)</span><input type="number" name="hire_fee" min="0" step="any" value="<%= fee || 0 %>"><small class="muted">0 if included in menu</small></label>
      </div>
      <label class="field"><span>Extra time, per 30 minutes (<%= currency %>)</span><input type="number" name="extra_time_fee" min="0" step="any" value="<%= extraFee || 0 %>">
        <small class="muted">Iftar bookings include <%= includedMinutes %> minutes from 20 minutes before Maghrib. Set a price to let hosts add up to 3 hours to any booking; 0 = no extra time.</small></label>
      <div class="row-2">
        <label class="field"><span>Dinner service starts</span><input type="time" name="dinner_start" required value="<%= venue.dinner_start || '21:30' %>"></label>
        <label class="field"><span>Dinner booking length</span>
          <select name="dinner_minutes">
            <% for (let m = 60; m <= 360; m += 30) { %><option value="<%= m %>" <%= Number(venue.dinner_minutes || 120) === m ? 'selected' : '' %>><%= fmt.duration(m) %></option><% } %>
          </select>
        </label>
      </div>
      <div class="row-2">
        <label class="field"><span>Nearest mosque <span class="muted">(optional)</span></span><input name="mosque_name" maxlength="120" value="<%= venue.mosque_name || '' %>" placeholder="Masjid-e-Noor"></label>
        <label class="field"><span>Walk to it (minutes)</span><input type="number" name="mosque_walk_minutes" min="1" max="60" value="<%= venue.mosque_walk_minutes || '' %>" placeholder="5"></label>
      </div>
      <p class="small muted">Hosts look for somewhere to pray Maghrib. Also tick “Prayer area on site” below if you have one.</p>
      <p class="small muted">Used for “Dinner only” bookings; “Iftar &amp; Dinner” runs from Iftar until dinner ends. Iftar and Dinner parties can share a night if their times don’t overlap.</p>
      <% const picked = ambience.parse(venue.ambience); %>
      <fieldset class="field ambience-pick">
        <legend>The space <span class="muted">(tick all that apply – hosts filter and choose by these)</span></legend>
        <div class="ambience-grid">
          <% ambience.AMBIENCE.forEach(([key, label]) => { %>
            <label class="check"><input type="checkbox" name="ambience" value="<%= key %>" <%= picked.includes(key) ? 'checked' : '' %>><span><%= label %></span></label>
          <% }) %>
        </div>
      </fieldset>
      <label class="field"><span>Description</span><textarea name="description" rows="4" placeholder="Seating style, prayer area, parking, décor…"><%= venue.description || '' %></textarea></label>
      <label class="field"><span>Other amenities <span class="muted">(comma separated)</span></span><input name="amenities" value="<%= venue.amenities || '' %>" placeholder="Air-conditioned, Prayer area, Valet parking, Projector"></label>

      <% if (images.length) { %>
        <p class="field-label">Current photos</p>
        <div class="thumbs">
          <% images.forEach(img => { %>
            <figure>
              <img src="<%= photoUrl(img.filename) %>" alt="">
              <button class="btn btn-small btn-ghost" formaction="/restaurant/venues/<%= venue.id %>/images/<%= img.id %>/delete?_csrf=<%= csrfToken %>" formnovalidate data-confirm="Remove this photo?">Remove</button>
            </figure>
          <% }) %>
        </div>
      <% } %>
      <label class="field">
        <span><%= images.length ? 'Add more photos' : 'Photos of the venue' %></span>
        <input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple data-photo-input <%= editing ? '' : 'required' %>>
        <small class="muted" data-upload-note><%= editing ? 'Up to 8 photos.' : 'At least 3, up to 8:' %> show the room, the seating and the setting. The first one is the cover. Large photos are resized automatically.</small>
      </label>
      <button class="btn btn-gold btn-block"><%= editing ? 'Save changes' : 'Publish venue' %></button>
    </form>
  </div>
</section>
<%- include('../partials/foot') %>
