<%- include('partials/head') %>
<%
  const budgets = [...[600, 900, 1200].map(n => [String(n), `Up to ${money.format(n * 100)}`]), ['', 'Any']];
  const pickedBudget = q.budget_type === 'total' ? '' : (q.budget || '');
  if (pickedBudget && !budgets.some(([v]) => v === pickedBudget) && Number(pickedBudget) > 0) budgets.splice(3, 0, [pickedBudget, `Up to ${money.format(Math.round(Number(pickedBudget) * 100))}`]);
%>
<section class="plan">
  <div class="wrap plan-wrap">
    <h1>Plan your Iftar party</h1>
    <p class="lead">Two quick questions. We’ll show venues that are free.</p>

    <form class="planner" method="get" action="/search" data-planner data-currency="<%= currency %>">
      <ol class="plan-progress" aria-hidden="true"><li class="on"></li><li></li></ol>

      <fieldset class="plan-step" data-step="1">
        <legend class="plan-q"><span class="plan-n">1 of 2</span>How many guests, and when?</legend>
        <label class="field">
          <span>Guests</span>
          <input type="number" name="guests" required min="1" max="2000" inputmode="numeric" placeholder="e.g. 50" value="<%= q.guests || '' %>">
        </label>
        <div class="quick" data-quick="guests">
          <% ['25', '50', '100', '200'].forEach(n => { %><button type="button" class="chip" data-value="<%= n %>"><%= n %></button><% }) %>
        </div>
        <label class="field">
          <span>Date</span>
          <input type="date" name="date" required min="<%= today %>" value="<%= q.date || '' %>">
        </label>
        <button type="button" class="btn btn-gold btn-block plan-next" data-next>Next</button>
      </fieldset>

      <fieldset class="plan-step" data-step="2">
        <legend class="plan-q"><span class="plan-n">2 of 2</span>Budget and area</legend>
        <div class="field">
          <span>Food budget per guest</span>
          <div class="seg">
            <% budgets.forEach(([v, label]) => { %>
              <label><input type="radio" name="budget" value="<%= v %>" <%= pickedBudget === v ? 'checked' : '' %>><span><%= label %></span></label>
            <% }) %>
          </div>
          <small class="muted" data-plan-estimate></small>
        </div>
        <label class="field">
          <span>Location <span class="muted">(optional)</span></span>
          <input name="location" placeholder="City or area" list="plan-cities" autocomplete="off" value="<%= q.location || '' %>">
          <datalist id="plan-cities"><% cities.forEach(c => { %><option value="<%= c.city %>"><% }) %></datalist>
        </label>
        <% if (cities.length) { %>
          <div class="quick" data-quick="location">
            <% cities.slice(0, 4).forEach(c => { %><button type="button" class="chip" data-value="<%= c.city %>"><%= c.city %></button><% }) %>
          </div>
        <% } %>
        <div class="plan-actions">
          <button type="button" class="btn btn-ghost" data-back>Back</button>
          <button class="btn btn-gold">Show venues</button>
        </div>
      </fieldset>
    </form>

    <p class="plan-trust small">Pay online · Venue reserved instantly · WhatsApp &amp; email invites</p>
  </div>
</section>
<%- include('partials/foot') %>
