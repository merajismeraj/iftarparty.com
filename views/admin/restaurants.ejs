<%- include('_open') %>
<h1>Restaurants</h1>
<form class="admin-filters" method="get">
  <input name="q" placeholder="Name, city, area or owner email" value="<%= q.q || '' %>">
  <select name="status"><option value="">All statuses</option><% statuses.forEach(s => { %><option <%= q.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select>
  <button class="btn btn-small">Filter</button>
</form>
<div class="table-wrap"><table>
  <thead><tr><th>Restaurant</th><th>Owner</th><th>Status</th><th>Halls</th><th>Menus</th><th>Bookings</th><th>GMV</th></tr></thead>
  <tbody><% rows.forEach(r => { %>
    <tr>
      <td><a href="/admin/restaurants/<%= r.id %>"><strong><%= r.name %></strong></a><br><span class="muted small"><%= [r.area, r.city].filter(Boolean).join(', ') %></span></td>
      <td class="small"><%= r.owner_name %><br><span class="muted"><%= r.owner_email %></span></td>
      <td><%- include('_status', { s: r.status }) %></td>
      <td><%= r.venues %></td><td><%= r.menus %></td><td><%= r.bookings %></td><td class="nowrap"><%= money.format(r.gmv) %></td>
    </tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="7" class="muted">No restaurants match.</td></tr><% } %></tbody>
</table></div>
<%- include('_pager') %>
<%- include('_close') %>
