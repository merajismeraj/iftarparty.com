<%- include('_open') %>
<p class="small"><a href="/admin/restaurants">← Restaurants</a></p>
<h1>Bulk upload restaurants</h1>
<div class="two-col">
  <div class="card form-card">
    <h2 class="h3">1. Fill the sample sheet</h2>
    <p><a class="btn btn-ghost btn-block" href="/admin/restaurants/template.csv" download>Download sample sheet (CSV)</a></p>
    <ul class="small muted">
      <li>One row = one restaurant, with an optional venue and set menu.</li>
      <li>Repeat the same <code>owner_email</code> on more rows to add more venues or menus.</li>
      <li>An email that already belongs to a partner adds to their existing restaurant.</li>
      <li>Amounts are in <%= currency %> (e.g. <code>899</code>). <code>venue_extra_time_fee</code> is per 30 minutes; 0 = no extra time.</li>
      <li>Separate amenities and dishes with <code>|</code>. Diet: veg, non-veg or mixed.</li>
      <li>Required: <%= required.join(', ') %>. Up to <%= maxRows %> rows.</li>
      <li>Owners sign in with Google using that email. Add photos and packages from the restaurant page afterwards.</li>
    </ul>
  </div>

  <form class="card form-card" method="post" action="/admin/restaurants/import?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
    <h2 class="h3">2. Upload it</h2>
    <label class="field"><span>CSV file</span><input type="file" name="file" accept=".csv,text/csv" required></label>
    <div class="field">
      <span>Status for new restaurants</span>
      <div class="seg seg-2">
        <label><input type="radio" name="status" value="approved" <%= status === 'approved' ? 'checked' : '' %>><span>Live now</span></label>
        <label><input type="radio" name="status" value="pending" <%= status === 'pending' ? 'checked' : '' %>><span>Pending review</span></label>
      </div>
    </div>
    <button class="btn btn-block" name="action" value="check">Check file</button>
    <p class="small muted">Nothing is saved until you confirm. If any row has a problem, nothing is imported.</p>
  </form>
</div>

<section class="card form-card">
  <h2 class="h3">Or add a city’s restaurants from OpenStreetMap</h2>
  <p class="small muted">Adds every named restaurant with its public details (name, cuisine, address, area, phone, website) as <strong>unclaimed</strong>: hidden from hosts and out of the review queue. OpenStreetMap has no capacity, menus, prices or photos, so add those when you onboard each restaurant, starting with setting its owner. Running it again refreshes unclaimed entries and never touches onboarded ones.</p>
  <form method="post" action="/admin/restaurants/import-osm?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" data-busy-form>
    <label class="field"><span>City</span><select name="city"><% cities.forEach(c => { %><option><%= c %></option><% }) %></select></label>
    <details class="small"><summary>Upload an Overpass export instead</summary>
      <label class="field"><span>Overpass JSON (optional, up to 4 MB)</span><input type="file" name="file" accept=".json,application/json"></label>
    </details>
    <button class="btn btn-block" data-busy-label="Fetching from OpenStreetMap… (up to a minute)">Fetch &amp; add restaurants</button>
  </form>
  <p class="small muted">Data © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap contributors</a>, ODbL.</p>
</section>

<% if (result) { %>
  <section class="card form-card">
    <% if (result.errors.length) { %>
      <h2 class="h3">Fix <%= result.errors.length %> problem<%= result.errors.length === 1 ? '' : 's' %>, then upload again</h2>
      <div class="table-wrap"><table>
        <thead><tr><th>Line</th><th>Problem</th></tr></thead>
        <tbody><% result.errors.forEach(e => { %><tr><td><%= e.line || '–' %></td><td><%= e.reason %></td></tr><% }) %></tbody>
      </table></div>
    <% } else { %>
      <h2 class="h3">Ready to import <%= result.rowCount %> row<%= result.rowCount === 1 ? '' : 's' %></h2>
      <p><%= result.created %> new restaurant<%= result.created === 1 ? '' : 's' %><%= result.extended ? `, ${result.extended} existing` : '' %> · <%= result.venues %> venue<%= result.venues === 1 ? '' : 's' %> · <%= result.menus %> menu<%= result.menus === 1 ? '' : 's' %></p>
      <div class="table-wrap"><table>
        <thead><tr><th>Restaurant</th><th>Owner</th><th>Venues</th><th>Menus</th></tr></thead>
        <tbody><% result.plan.forEach(p => { %>
          <tr>
            <td><strong><%= p.existing ? p.existing.name : p.name %></strong><br><span class="muted small"><%= p.existing ? 'Existing – adds below' : [p.area, p.city].filter(Boolean).join(', ') %></span></td>
            <td class="small"><%= p.owner %><br><span class="muted"><%= p.email %></span></td>
            <td class="small"><%= p.venues.map(v => `${v.name} (${v.min_pax}–${v.max_pax})`).join(', ') || '–' %></td>
            <td class="small"><%= p.menus.map(m => `${m.name} ${money.format(m.price_per_person)}`).join(', ') || '–' %></td>
          </tr>
        <% }) %></tbody>
      </table></div>
      <form method="post" action="/admin/restaurants/import?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
        <input type="hidden" name="sheet" value="<%= result.sheet %>">
        <input type="hidden" name="filename" value="<%= result.filename %>">
        <input type="hidden" name="status" value="<%= status %>">
        <button class="btn btn-gold btn-block" name="action" value="import">Import <%= result.created + result.extended %> restaurant<%= result.created + result.extended === 1 ? '' : 's' %> (<%= status === 'approved' ? 'live now' : 'pending review' %>)</button>
      </form>
    <% } %>
  </section>
<% } %>
<%- include('_close') %>
