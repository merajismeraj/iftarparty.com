<a class="card venue-card" href="/venues/<%= v.id %><%= locals.qs ? `?${qs}` : '' %>">
  <div class="venue-card-img">
    <% if (v.image) { %><img src="<%= photoUrl(v.image) %>" alt="<%= v.name %>" loading="lazy"><% } else { %><div class="img-fallback">No photo</div><% } %>
    <span class="pill pill-dark">Up to <%= v.max_pax %> guests</span>
  </div>
  <div class="venue-card-body">
    <div class="venue-card-title">
      <h3><%= v.name %></h3>
      <% if (v.review_count) { %><span class="small card-rating"><span class="star-one">★</span> <strong><%= v.rating %></strong> <span class="muted">(<%= v.review_count %>)</span></span><% } %>
    </div>
    <p class="muted small"><%= [v.area, v.city].filter(Boolean).join(', ') %></p>
    <div class="venue-card-foot">
      <span><span class="muted small">from</span> <strong><%= money.format(v.from_price) %></strong><span class="muted small">/guest</span></span>
      <% if (locals.est) { %><span class="small budget-est">≈ <%= money.format(est) %> total</span><% } %>
    </div>
  </div>
</a>
