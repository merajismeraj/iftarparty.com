<a class="card venue-card" href="/venues/<%= v.id %><%= locals.qs ? `?${qs}` : '' %>">
  <div class="venue-card-img">
    <% if (v.image) { %><img src="/uploads/<%= v.image %>" alt="<%= v.name %>" loading="lazy"><% } else { %><div class="img-fallback">☾</div><% } %>
    <span class="pill pill-dark">Up to <%= v.max_pax %> guests</span>
  </div>
  <div class="venue-card-body">
    <h3><%= v.name %></h3>
    <p class="muted"><%= v.restaurant_name %> · <%= [v.area, v.city].filter(Boolean).join(', ') %></p>
    <% if (v.menu_names) { %><p class="small menu-names"><%= v.menu_names.split(',').slice(0, 3).join(' · ') %></p><% } %>
    <div class="venue-card-foot">
      <span><span class="muted small">from</span> <strong><%= money.format(v.from_price) %></strong><span class="muted small">/guest</span></span>
      <span class="small muted"><%= v.min_pax %>–<%= v.max_pax %> pax</span>
    </div>
  </div>
</a>
