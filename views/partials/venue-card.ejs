<%
  const pics = v.images && v.images.length ? v.images : (v.image ? [v.image] : []);
  const more = Math.max(0, Number(v.image_count || pics.length) - pics.length);
%>
<a class="vcard" href="/venues/<%= v.id %><%= locals.qs ? `?${qs}` : '' %>">
  <div class="vcard-gal n<%= Math.min(pics.length, 3) %>">
    <% if (!pics.length) { %><div class="img-fallback">No photo yet</div><% } %>
    <% pics.forEach((p, i) => { %>
      <div class="vcard-ph <%= i === 0 ? 'main' : '' %>">
        <img src="<%= photoUrl(p) %>" alt="<%= i === 0 ? `${v.name} at ${v.restaurant_name}` : '' %>" <%= (locals.i || i) ? 'loading="lazy"' : 'fetchpriority="high"' %>>
        <% if (i === pics.length - 1 && more) { %><span class="vcard-more">+<%= more %> photo<%= more === 1 ? '' : 's' %></span><% } %>
      </div>
    <% }) %>
  </div>
  <div class="vcard-body">
    <h2 class="vcard-title"><%= v.restaurant_name %></h2>
    <p class="vcard-space"><%= v.name %></p>
    <p class="vcard-meta"><%= [v.area, v.city].filter(Boolean)[0] || v.city %><% if (v.review_count) { %> · <span class="star-one">★</span> <%= v.rating %> (<%= v.review_count %>)<% } %> · up to <%= v.max_pax %></p>
    <% if (v.vibes && v.vibes.length) { %>
      <div class="vcard-vibes"><% v.vibes.slice(0, 4).forEach(l => { %><span><%= l %></span><% }) %></div>
    <% } %>
    <% if (v.prayer) { %><p class="vcard-prayer"><svg class="prayer-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5c.3 1.6 1.6 2.4 1.6 3.6a1.6 1.6 0 0 1-3.2 0c0-1.2 1.3-2 1.6-3.6ZM5 21V12a7 7 0 0 1 14 0v9h-4v-4a3 3 0 0 0-6 0v4H5Z" fill="currentColor"/></svg><%= v.prayer.lines.join(' · ') %></p><% } %>
    <% if (v.dishes && v.dishes.length) { %>
      <p class="vcard-label">On the table</p>
      <div class="vcard-dishes"><% v.dishes.forEach(d => { %><span><%= d %></span><% }) %><% if (v.dish_count > v.dishes.length) { %><span class="muted">+<%= v.dish_count - v.dishes.length %></span><% } %></div>
    <% } %>
    <div class="vcard-price">
      <span><strong><%= money.format(v.from_price) %></strong> <span class="muted small">/guest</span></span>
      <% if (locals.est) { %><span class="vcard-est">≈ <%= money.format(est) %><%= locals.guests ? ` for ${guests}` : '' %></span><% } %>
    </div>
  </div>
</a>
