<div class="summary">
  <% if (b.image) { %><img src="<%= photoUrl(b.image) %>" alt="<%= b.venue_name %>"><% } %>
  <div>
    <h2 class="h3"><%= b.title %></h2>
    <p><strong><%= b.venue_name %></strong> · <%= b.restaurant_name %><br><span class="muted"><%= [b.address, b.area, b.city].filter(Boolean).join(', ') %></span></p>
    <p><%= fmt.longDate(b.event_date) %> · arrive <%= fmt.time12(b.arrival_time) %><br><%= b.guest_count %> guests · <%= b.menu_name %></p>
    <% if ((locals.dishes || []).length) { %>
      <div class="menu-selection small"><% dishes.forEach(g => { %><div><span class="muted"><%= g.label %>:</span> <%= g.dishes.map(d => d.name).join(', ') %></div><% }) %></div>
    <% } %>
  </div>
</div>
<div class="quote">
  <div><span><%= b.guest_count %> × <%= money.format(b.price_per_person, b.currency) %></span><span><%= money.format(b.food_total, b.currency) %></span></div>
  <% (locals.addons || []).forEach(a => { %>
    <div><span><%= a.name %><%= a.pricing === 'per_guest' ? ` (${a.quantity} × ${money.format(a.unit_price, b.currency)})` : '' %></span><span><%= money.format(a.total, b.currency) %></span></div>
  <% }) %>
  <div><span>Hall fee</span><span><%= money.format(b.hire_fee, b.currency) %></span></div>
  <div><span>Service fee</span><span><%= money.format(b.platform_fee, b.currency) %></span></div>
  <div class="total"><span>Total</span><span><%= money.format(b.total_amount, b.currency) %></span></div>
</div>
