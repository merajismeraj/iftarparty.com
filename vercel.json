{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "{views/**,public/**,scripts/**,node_modules/@electric-sql/pglite/dist/*.{wasm,data}}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
