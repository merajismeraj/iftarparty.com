# --- Core ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
# Postgres. Supabase: use the pooled "Transaction" URL (port 6543). Leave empty to use PGlite (in-process
# Postgres) stored in DATABASE_PATH.
DATABASE_URL=
DATABASE_PATH=./data/pglite
# Supabase Storage for venue photos (server-side key). Leave empty to store photos in UPLOAD_DIR.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_DIR=./uploads

# Money is stored in minor units (paise/cents). Currency is ISO-4217.
CURRENCY=INR
PLATFORM_FEE_PERCENT=5
# Minutes an unpaid booking holds the venue while the host pays.
BOOKING_HOLD_MINUTES=30
# Used to normalise local mobile numbers to E.164 (e.g. 91 for India).
DEFAULT_COUNTRY_CODE=91

# --- First-boot admin (hosts without a shell). Created only if no admin exists yet; remove the password after signing in. ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Google sign-in. Leave blank to hide the button. Redirect URI to register: <BASE_URL>/auth/google/callback ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Cashfree Payment Gateway). Leave blank to use the built-in demo payment page. ---
# Keys: Cashfree Merchant Dashboard > Developers > API Keys. Webhook URL: <BASE_URL>/webhooks/cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# --- Email (SMTP). Leave SMTP_HOST blank to log emails to the console/outbox instead. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IftarParty <invites@iftarparty.com>"

# --- WhatsApp: Meta WhatsApp Cloud API (official). Leave the token blank to log messages instead. ---
# Permanent system-user token and the phone number ID (WhatsApp → API Setup), not the phone number.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved Utility templates (see README for the exact wording and variable order).
WHATSAPP_TEMPLATE_NAME=iftar_invite
WHATSAPP_CANCEL_TEMPLATE_NAME=iftar_cancelled
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0
# Delivery receipts: callback URL <BASE_URL>/webhooks/whatsapp, subscribed to "messages".
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
