# --- Core ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/iftarparty.db
UPLOAD_DIR=./uploads

# Money is stored in minor units (paise/cents). Currency is ISO-4217.
CURRENCY=INR
PLATFORM_FEE_PERCENT=5
# Minutes an unpaid booking holds the venue (Stripe Checkout needs >= 30).
BOOKING_HOLD_MINUTES=30
# Used to normalise local mobile numbers to E.164 (e.g. 91 for India).
DEFAULT_COUNTRY_CODE=91

# --- Payments (Stripe Checkout). Leave blank to use the built-in demo payment page. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (SMTP). Leave SMTP_HOST blank to log emails to the console/outbox instead. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IftarParty <invites@iftarparty.com>"

# --- WhatsApp Cloud API (Meta). Leave blank to log WhatsApp messages instead. ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=iftar_invite
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
